# Copy this file to .env and fill it in. Never commit .env.

# ---- Required ----

# Twilio console > Account info
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token

# The Twilio number you bought, in E.164 format
TWILIO_NUMBER=+15551234567

# console.anthropic.com > API keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Your ngrok host, no https:// and no trailing slash
PUBLIC_HOST=abc123.ngrok-free.app

# ---- Optional (defaults shown) ----

MODEL=claude-sonnet-5-5

# Where the agent opens the mock sites. Defaults to the public host; local skips ngrok's warning page.
SITE_BASE=http://localhost:8000

# Languages in menu order: "en,zh" plays "press 1 for English, 2 for Chinese".
# Use a single language ("en" or "zh") to skip the menu.
LANGUAGES=en,zh
DEFAULT_LANGUAGE=en

# Chinese voice settings. Uncomment to override if a Chinese call fails.
# See "Chinese voice not working" in docs/SETUP.md for fallbacks.
# ZH_TTS_LANGUAGE=cmn-CN
# ZH_TTS_PROVIDER=Google
# ZH_VOICE=cmn-CN-Standard-A
# ZH_TRANSCRIPTION_LANGUAGE=cmn-Hans-CN
# ZH_TRANSCRIPTION_PROVIDER=Google
# ZH_SPEECH_MODEL=telephony
# ZH_MENU_SAY_LANGUAGE=cmn-CN
# ZH_MENU_SAY_VOICE=Polly.Zhiyu
# English has the same settings with an EN_ prefix.

# Guard limits per task
MAX_STEPS=25
MAX_MINUTES=15
TOKEN_BUDGET=400000
# Dollars per task. The guard stops before the next model call would cross it.
COST_BUDGET=0.50

# Seconds to wait for the caller to answer a question
ASK_TIMEOUT=180
# Seconds to keep the result call open after reading the result
RESULT_HOLD=15
# Seconds of silence before the caller counts as done talking
SPEECH_PAUSE=2
# Seconds to wait before each callback, so a demo has room to breathe (0 = off)
CALL_DELAY=0
# Tasks that can run at the same time
MAX_CONCURRENT=3
# Extra tries if the caller misses the result call
CALLBACK_RETRIES=1

# Check that webhooks really come from Twilio. Turn on once everything works.
VALIDATE_TWILIO=false

DB_PATH=dialup.db
